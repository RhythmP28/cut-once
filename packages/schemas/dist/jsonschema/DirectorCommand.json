{
  "$ref": "#/definitions/DirectorCommand",
  "definitions": {
    "DirectorCommand": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "new_run"
            },
            "seed": {
              "type": "string"
            },
            "plan_id": {
              "type": "string",
              "pattern": "^plan_[a-z0-9_]+$"
            }
          },
          "required": [
            "type",
            "seed"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "force_state"
            },
            "part_id": {
              "type": "string",
              "pattern": "^part_[a-z0-9_]+$"
            },
            "new_state": {
              "type": "string",
              "enum": [
                "missing",
                "built",
                "wrong"
              ]
            }
          },
          "required": [
            "type",
            "part_id",
            "new_state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "goto"
            },
            "demo_state": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "demo_state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "set_flag"
            },
            "flag": {
              "type": "string",
              "enum": [
                "verification",
                "offline",
                "reconstruction"
              ]
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "flag",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "promote_cache"
            },
            "turn_id": {
              "type": "string",
              "pattern": "^turn_[a-z0-9_]+$"
            },
            "scripted_query_id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "turn_id",
            "scripted_query_id"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
