{
  "$ref": "#/definitions/VerificationResult",
  "definitions": {
    "VerificationResult": {
      "type": "object",
      "properties": {
        "verification_id": {
          "type": "string",
          "pattern": "^ver_[a-z0-9_]+$"
        },
        "part_id": {
          "type": "string",
          "pattern": "^part_[a-z0-9_]+$"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "present",
            "absent",
            "wrong_orientation",
            "unsure"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "verification_id",
        "part_id",
        "verdict",
        "confidence",
        "evidence",
        "model",
        "ms"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
