{
  "$ref": "#/definitions/Assembly",
  "definitions": {
    "Assembly": {
      "type": "object",
      "properties": {
        "assembly_id": {
          "type": "string",
          "pattern": "^asm_[a-z0-9_]+$"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^plan_[a-z0-9_]+$"
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "seed": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "archived"
          ]
        }
      },
      "required": [
        "assembly_id",
        "plan_id",
        "plan_revision",
        "name",
        "seed",
        "created_at",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
