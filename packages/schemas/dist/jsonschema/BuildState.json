{
  "$ref": "#/definitions/BuildState",
  "definitions": {
    "BuildState": {
      "type": "object",
      "properties": {
        "assembly_id": {
          "type": "string",
          "pattern": "^asm_[a-z0-9_]+$"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^plan_[a-z0-9_]+$"
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 1
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "as_of": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "parts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "missing",
                  "built",
                  "wrong"
                ]
              },
              "since_version": {
                "type": "integer",
                "minimum": 0
              },
              "last_event_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "verified": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "verdict": {
                        "type": "string",
                        "enum": [
                          "present",
                          "absent",
                          "wrong_orientation",
                          "unsure"
                        ]
                      },
                      "confidence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "verdict",
                      "confidence"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "state",
              "since_version",
              "last_event_id",
              "verified"
            ],
            "additionalProperties": false
          }
        },
        "progress": {
          "type": "object",
          "properties": {
            "built": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "pct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "by_layer": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ]
              }
            },
            "minutes_left": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "built",
            "total",
            "pct",
            "by_layer",
            "minutes_left"
          ],
          "additionalProperties": false
        },
        "current_step_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^step_[a-z0-9_]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "available_part_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^part_[a-z0-9_]+$"
          }
        },
        "blocked_part_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^part_[a-z0-9_]+$"
          }
        },
        "out_of_sequence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "part_id": {
                "type": "string",
                "pattern": "^part_[a-z0-9_]+$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "hard",
                  "soft"
                ]
              }
            },
            "required": [
              "part_id",
              "kind"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "assembly_id",
        "plan_id",
        "plan_revision",
        "version",
        "as_of",
        "parts",
        "progress",
        "current_step_id",
        "available_part_ids",
        "blocked_part_ids",
        "out_of_sequence"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
