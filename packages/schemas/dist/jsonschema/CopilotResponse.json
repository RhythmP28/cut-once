{
  "$ref": "#/definitions/CopilotResponse",
  "definitions": {
    "CopilotResponse": {
      "type": "object",
      "properties": {
        "turn_id": {
          "type": "string",
          "pattern": "^turn_[a-z0-9_]+$"
        },
        "transcript": {
          "type": "string"
        },
        "answer_text": {
          "type": "string"
        },
        "highlight_parts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^part_[a-z0-9_]+$"
          }
        },
        "highlight_style": {
          "type": "string",
          "enum": [
            "pulse",
            "path"
          ]
        },
        "drawing_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "document_id": {
                "type": "string",
                "pattern": "^doc_[a-z0-9_]+$"
              },
              "sheet_id": {
                "type": "string",
                "pattern": "^sheet_[a-z0-9_]+$"
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "chunk_id": {
                "type": "string",
                "pattern": "^chunk_[a-z0-9_]+$"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "document_id",
              "page",
              "title"
            ],
            "additionalProperties": false
          }
        },
        "action": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "mark_state"
                    },
                    "part_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^part_[a-z0-9_]+$"
                      }
                    },
                    "new_state": {
                      "type": "string",
                      "enum": [
                        "missing",
                        "built",
                        "wrong"
                      ]
                    },
                    "source": {
                      "type": "string",
                      "const": "voice"
                    }
                  },
                  "required": [
                    "type",
                    "part_ids",
                    "new_state",
                    "source"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "log_issue"
                    },
                    "issue_id": {
                      "type": "string",
                      "pattern": "^issue_[a-z0-9_]+$"
                    }
                  },
                  "required": [
                    "type",
                    "issue_id"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needs_clarification": {
          "type": "boolean"
        },
        "audio_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "cached": {
          "type": "boolean"
        },
        "timings_ms": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": [
        "turn_id",
        "transcript",
        "answer_text",
        "highlight_parts",
        "highlight_style",
        "drawing_refs",
        "action",
        "confidence",
        "needs_clarification",
        "audio_url",
        "cached",
        "timings_ms"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
