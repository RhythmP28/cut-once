[Unit]
Description=Cut Once API
After=network-online.target
Wants=network-online.target

[Service]
User=cutonce
WorkingDirectory=/opt/cutonce
EnvironmentFile=/etc/cutonce.env
Environment=NODE_ENV=production
Environment=DATA_DIR=/var/lib/cutonce
ExecStart=/usr/bin/env pnpm -F @cutonce/api exec tsx src/server.ts
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
