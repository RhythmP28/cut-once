# Copy to .env.local (pnpm serve:local does it and fills in API_TOKEN). Never commit real values.
PORT=8080
HOST=127.0.0.1
DATA_DIR=./data/runtime
API_TOKEN=
PUBLIC_BASE_URL=
ES_URL=
ES_API_KEY=
KIBANA_URL=
AGENT_BUILDER_MCP_URL=
# Elastic Cloud 9.4+: .jina-embeddings-v5-text-small and .jina-reranker-v3 (9.5+: .jina-reranker-v3.5). Confirm with GET _inference/_all.
JINA_EMBED_ID=
JINA_RERANK_ID=
SEARCH_MODE=bm25
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
RECONSTRUCTION=off
# ── copilot (pillar C) ───────────────────────────────────────────────────────
# off | fake (canned answers from the plan, no keys: for testing the headset) | live (the real copilot)
COPILOT_MODE=off
FAKE_COPILOT_DELAY_MS=1200
# Set this if G0 shows the default model does not accept images. Nothing else has to change.
OPENAI_COPILOT_MODEL=
OPENAI_STT_MODEL=gpt-transcribe
ELEVENLABS_MODEL=eleven_flash_v2_5
# Stage timeouts in ms. COPILOT_CAP_MS is the hard cap: past it the cached answer is served.
COPILOT_STT_MS=3000
COPILOT_RETRIEVE_MS=800
COPILOT_LLM_MS=6000
COPILOT_CAP_MS=9000
COPILOT_VERIFY_MS=8000
# How long finished answer audio stays in memory for live streaming (ms); after that it is served from disk.
COPILOT_AUDIO_RETAIN_MS=60000
# ── build mode (the Lego Movie) ──────────────────────────────────────────────
# Each defaults to OPENAI_MODEL (the router to OPENAI_COPILOT_MODEL first). The router should be the smallest, fastest
# model the key lists: it has COPILOT_ROUTE_MS to answer, and a slower one only ever times out, which makes every turn
# a plain question. The label model must accept images.
OPENAI_ROUTER_MODEL=
OPENAI_LABEL_MODEL=
OPENAI_IDEAS_MODEL=
COPILOT_ROUTE_MS=700
DEFAULT_SEED=e7_start
